{
  "collections": {
    "users": {
      "__description": "User profiles and quota wallets.",
      "__fields": {
        "email": "string",
        "name": "string",
        "role": "string",
        "avatar": "string",
        "credits": "number",
        "createdAt": "timestamp",
        "lastLoginAt": "timestamp",
        "plan": "string"
      },
      "__security": {
        "read": "request.auth != null && (request.auth.uid == documentId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'developer')",
        "write": "request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'developer'",
        "create": "request.auth != null && request.auth.uid == documentId"
      },
      "__example": {
        "email": "user@example.com",
        "name": "John Doe",
        "role": "user",
        "avatar": "https://avatar.url",
        "credits": 10,
        "createdAt": "2024-01-01T00:00:00Z",
        "lastLoginAt": "2024-01-02T00:00:00Z",
        "plan": "free"
      }
    },
    "api_keys": {
      "__description": "Centralized API Keys controlled by developer.",
      "__fields": {
        "provider": "string",
        "key": "string",
        "updatedAt": "timestamp",
        "status": "string"
      },
      "__security": {
        "read": "request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'developer'",
        "write": "request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'developer'"
      },
      "__example": {
        "provider": "gemini",
        "key": "AIzaSy...",
        "updatedAt": "2024-01-01T00:00:00Z",
        "status": "active"
      }
    },
    "deliberation_audits": {
      "__description": "Tamper-evident deliberation council records, telemetry metrics, and quality verification logs.",
      "__fields": {
        "auditId": "string",
        "taskId": "string",
        "originalPrompt": "string",
        "councilDeliberation": "map",
        "selectedEngine": "string",
        "verificationPass": "boolean",
        "integrityHash": "string",
        "telemetryScore": "number",
        "createdAt": "timestamp"
      },
      "__security": {
        "read": "request.auth != null",
        "write": "request.auth != null"
      },
      "__example": {
        "auditId": "audit_1728000000",
        "taskId": "task_101",
        "originalPrompt": "Analisis likuiditas XAUUSD",
        "councilDeliberation": {},
        "selectedEngine": "retailTraderGitHubEngine",
        "verificationPass": true,
        "integrityHash": "a1b2c3d4...",
        "telemetryScore": 98.4,
        "createdAt": "2026-10-12T00:00:00Z"
      }
    }
  }
}
