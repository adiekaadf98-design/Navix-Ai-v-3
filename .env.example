# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Google Cloud Vertex AI Configuration
# Note (from audit): Imagen 3 API was shut down by Google on 2026-08-17.
# Current image generation in this app actually uses Pollinations.ai
# (sovereignMediaEngine.ts), NOT Vertex Imagen. If you want real Gemini
# Image ("Nano Banana") generation instead, use model IDs like
# gemini-3-pro-image-preview or gemini-2.5-flash-image via generateContent,
# not the old generateImages()/imagen-3.0-* path.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# --- Real developer/consumer access control (added by audit fix) ---
# Comma-separated list of Google account emails that get the "developer"
# role: unlimited chat/generation, and the ONLY accounts allowed to call
# /api/admin/keys and /api/admin/keys/status to manage the shared Gemini
# API key pool. Everyone else (any other Google login, or anonymous/IP)
# is treated as a free consumer and capped at NAVIX_DAILY_FREE_LIMIT
# requests/day, enforced server-side in src/backend/middleware/quota.ts.
NAVIX_DEVELOPER_EMAILS="adiekaadf98@gmail.com,adieka.github@gmail.com"

# How many free chat/generation requests per day a non-developer consumer
# gets. Enforced server-side (real, cannot be bypassed by clearing
# localStorage) via Postgres (DATABASE_URL below) with an in-memory
# fallback if Postgres isn't configured.
NAVIX_DAILY_FREE_LIMIT=5

# Recommended: set DATABASE_URL (see docker-compose.yml) so the daily
# quota counters persist across server restarts and are shared correctly
# if you ever run more than one server instance. Without it, quota still
# works but resets whenever the process restarts.
DATABASE_URL=
